        "jsonBody": "={\n  \"state\": {{ JSON.stringify($json.message) }},\n  \"model\": \"jev-latest\",\n  \"questions\": {\n    \"department\": {\n      \"type\": \"choice\",\n      \"instructions\": \"Which team should handle this message?\",\n      \"criteria\": {\n        \"billing\": \"Payments, invoices, refunds, pricing disputes, failed debit orders\",\n        \"technical\": \"Bugs, errors, outages, logins, integrations, anything broken\",\n        \"sales\": \"Pricing questions before buying, upgrades, demos, new accounts\"\n      }\n    },\n    \"urgency\": {\n      \"type\": \"score\",\n      \"instructions\": \"How quickly does this need a response?\",\n      \"criteria\": [\"Not urgent\", \"Needs attention this week\", \"Blocking business right now\"]\n    },\n    \"is_spam\": {\n      \"type\": \"choice\",\n      \"instructions\": \"Is this a genuine customer enquiry or unsolicited spam?\",\n      \"criteria\": {\n        \"no\": \"A real customer or prospect contacting the business\",\n        \"yes\": \"Unsolicited marketing, scams, cold outreach or phishing\"\n      }\n    },\n    \"frustration\": {\n      \"type\": \"score\",\n      \"instructions\": \"How frustrated is the sender?\",\n      \"criteria\": [\"Calm\", \"Frustrated\", \"Very angry\"]\n    }\n  }\n}\n",
        "options": {}
